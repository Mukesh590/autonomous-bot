# Copy this file to .env and fill in your values.
# NEVER commit the real .env to git.

# Alpaca paper trading credentials
# Get these from: https://app.alpaca.markets → Paper Trading → API Keys
ALPACA_API_KEY=your_api_key_here
ALPACA_SECRET_KEY=your_secret_key_here

# Paper trading endpoint (do not change for paper trading)
ALPACA_BASE_URL=https://paper-api.alpaca.markets

# Optional: override log directory (Railway persistent volume path)
# LOG_DIR=/data/logs
